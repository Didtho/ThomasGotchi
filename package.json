{
  "name": "thomasgotchi",
  "version": "1.4.0",
  "description": "Un petit être virtuel façon Tamagotchi qui vit sur le bureau (Windows et Mac)",
  "main": "main.js",
  "author": "ThomasGotchi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.thomasgotchi.app",
    "productName": "ThomasGotchi",
    "files": [
      "main.js",
      "preload.js",
      "preload-poop.js",
      "preload-yarn.js",
      "src/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ThomasGotchi",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Didtho",
        "repo": "ThomasGotchi",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
